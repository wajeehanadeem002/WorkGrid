# Clerk authentication (public key is safe for browser use; secret key is server-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Supabase native Clerk integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public canonical origin used for absolute links. Never derive it from an untrusted Host header.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only HMAC secret used to authorize controlled attachment and invitation RPCs.
# Generate at least 32 random bytes and provision the same value in private.workgrid_server_config.
WORKGRID_SERVER_PROOF_SECRET=replace_with_at_least_32_random_characters

# Local Supabase CLI only: set the Clerk issuer domain in supabase/config.toml or dashboard.
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev
